{
  "title": "智慧超市收银系统监控",
  "uid": "supermarket-cashier",
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "订单创建速率 (每分钟)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{
        "expr": "rate(business_order_created_total[1m]) * 60",
        "legendFormat": "订单/分钟",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "title": "订单成功/失败数",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{
        "expr": "business_order_success_total",
        "legendFormat": "成功",
        "refId": "A"
      }, {
        "expr": "business_order_fail_total",
        "legendFormat": "失败",
        "refId": "B"
      }]
    },
    {
      "id": 3,
      "title": "订单总金额",
      "type": "stat",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{
        "expr": "business_order_amount_total / 100",
        "legendFormat": "金额(元)",
        "refId": "A"
      }]
    },
    {
      "id": 4,
      "title": "登录统计",
      "type": "stat",
      "gridPos": {"x": 12, "y": 4, "w": 6, "h": 4},
      "targets": [{
        "expr": "business_login_success_total",
        "legendFormat": "密码登录成功",
        "refId": "A"
      }, {
        "expr": "business_face_login_success_total",
        "legendFormat": "人脸登录成功",
        "refId": "B"
      }]
    },
    {
      "id": 5,
      "title": "HTTP请求QPS",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [{
        "expr": "rate(http_server_requests_seconds_count[1m])",
        "legendFormat": "{{method}} {{uri}}",
        "refId": "A"
      }]
    },
    {
      "id": 6,
      "title": "P95响应时间",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket[5m]))",
        "legendFormat": "P95",
        "refId": "A"
      }]
    },
    {
      "id": 7,
      "title": "JVM堆内存使用",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [{
        "expr": "jvm_memory_used_bytes{area='heap'}",
        "legendFormat": "已使用",
        "refId": "A"
      }, {
        "expr": "jvm_memory_max_bytes{area='heap'}",
        "legendFormat": "最大值",
        "refId": "B"
      }]
    },
    {
      "id": 8,
      "title": "JVM CPU使用率",
      "type": "gauge",
      "gridPos": {"x": 12, "y": 16, "w": 6, "h": 8},
      "targets": [{
        "expr": "system_cpu_usage * 100",
        "legendFormat": "CPU %",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      }
    },
    {
      "id": 9,
      "title": "数据库连接池",
      "type": "timeseries",
      "gridPos": {"x": 18, "y": 16, "w": 6, "h": 8},
      "targets": [{
        "expr": "hikaricp_connections_active",
        "legendFormat": "活跃连接",
        "refId": "A"
      }, {
        "expr": "hikaricp_connections_idle",
        "legendFormat": "空闲连接",
        "refId": "B"
      }]
    }
  ]
}